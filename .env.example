# ---- Přístup do aplikace ----
APP_PASSWORD=
# Vygeneruj např: openssl rand -base64 32
SESSION_SECRET=

# ---- Databáze (Supabase) ----
# Založ nový projekt na supabase.com a v SQL Editoru spusť supabase/schema.sql
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Google API (vyhledávání firem a PageSpeed) ----
GOOGLE_PLACES_API_KEY=
PAGESPEED_API_KEY=

# ---- AI (Google Gemini pro marketingové audity a cold outreach) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ---- Telegram notifikace (volitelné) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Odesílání e-mailů (SMTP) ----
SMTP_HOST=smtp.seznam.cz
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- Veřejné marketingové rozbory ----
# Lokálně: http://localhost:3000/a
# Produkce: např. https://audit.vasedomena.cz nebo https://vasedomena.cz/a
AUDIT_BASE_URL=http://localhost:3000/a
AUDIT_HOST=

# ---- Branding agentury (podpisy v e-mailech a kontakty na auditu) ----
SENDER_NAME=Marketingový stratég
SENDER_COMPANY=Marketingová Agentura
SENDER_WEB=https://www.vasedomena.cz
SENDER_EMAIL=info@vasedomena.cz
SENDER_PHONE=+420 777 000 000
NEXT_PUBLIC_APP_TITLE=MarketingRadar
